        <span class="s1">document.getElementById(</span><span class="s3">'modalService'</span><span class="s1">).textContent = serviceName;</span>

        <span class="s8">const </span><span class="s1">priceRow = document.getElementById(</span><span class="s3">'modalPriceRow'</span><span class="s1">);</span>
        <span class="s8">if </span><span class="s1">(packageData[currentSelectedKey]) {</span>
            <span class="s8">const </span><span class="s1">discounted = packageData[currentSelectedKey].price * </span><span class="s5">0.9</span><span class="s1">;</span>
            <span class="s1">document.getElementById(</span><span class="s3">'modalPrice'</span><span class="s1">).textContent = discounted.toLocaleString(</span><span class="s3">'ru-RU'</span><span class="s1">) + </span><span class="s3">' ₽'</span><span class="s1">;</span>
            <span class="s1">priceRow.classList.remove(</span><span class="s3">'hidden'</span><span class="s1">);</span>
        <span class="s1">} </span><span class="s8">else </span><span class="s1">{</span>
            <span class="s1">priceRow.classList.add(</span><span class="s3">'hidden'</span><span class="s1">);</span>
        <span class="s1">}</span>

        <span class="s1">document.getElementById(</span><span class="s3">'modalOverlay'</span><span class="s1">).classList.remove(</span><span class="s3">'hidden'</span><span class="s1">);</span>
    <span class="s1">}</span>

    <span class="s4">// Закрытие модального окна и сброс полей</span>
